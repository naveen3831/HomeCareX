{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "composite": true,
"emitDeclarationOnly": true,
  },
  "include": ["vite.config.ts", "scripts/**/*.ts", "src/constants/routes.ts"]
}
{
  "name": "homecarex-backend",
  "version": "1.0.0",
  "description": "HomeCareX Backend REST API & Realtime Services",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "node scripts/run-seed.js",
    "seed:users": "ts-node --transpile-only src/scripts/seed-users.ts",
    "seed:p04": "ts-node --transpile-only src/scripts/seed-p04.ts",
    "seed:incentives": "ts-node --transpile-only src/scripts/seed-incentives.ts",
    "seed:dashboard": "ts-node --transpile-only src/scripts/seed-dashboard.ts",
    "seed:customers": "ts-node --transpile-only src/scripts/seed-admin-customers.ts",
    "seed:catalog": "ts-node --transpile-only src/scripts/seed-catalog.ts",
    "seed:service-reviews": "ts-node --transpile-only src/scripts/seed-service-reviews.ts",
    "seed:wallet": "ts-node --transpile-only src/scripts/seed-wallet-transactions.ts",
    "create:admin": "ts-node --transpile-only src/scripts/create-admin.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "repair:partners": "ts-node --transpile-only src/scripts/repair-partner-profiles.ts",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "razorpay": "^2.9.8",
    "redis": "^4.6.13",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.24",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mingo": "^7.2.4",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.19.0"
  }
}

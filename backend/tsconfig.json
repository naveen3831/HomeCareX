{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "ignoreDeprecations": "5.0",

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/modules/tickets-backup/**/*",
    "src/modules/tickets/tickets.service.ts",
    "src/modules/tickets/tickets.upload.ts",
    "src/modules/pricing/pricing.admin.service.ts",
    "src/scripts/seed-partner-reviews.ts"
  ]
}